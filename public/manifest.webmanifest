{
    "name": "Sổ tay",
    "short_name": "Sổ tay",
    "description": "Sổ tay tài chính & gia đình: ngày nhớ, sức khỏe, sửa chữa, vàng, tài sản.",
    "lang": "vi",
    "start_url": "/tong-tai-san",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#f3f4f6",
    "theme_color": "#047857",
    "icons": [
        {
            "src": "/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "/icons/icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "share_target": {
        "action": "/gui-file/chia-se",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "files",
                    "accept": [
                        "*/*"
                    ]
                }
            ]
        }
    },
    "shortcuts": [
        {
            "name": "Gửi file",
            "short_name": "Gửi file",
            "description": "Gửi file giữa hai thiết bị",
            "url": "/gui-file",
            "icons": [
                {
                    "src": "/icons/icon-192.png?v=2",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        }
    ]
}
